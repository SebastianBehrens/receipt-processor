# Non-secret runtime config (optional).
# Secrets are loaded by load-secrets.sh from 1Password + htpasswd — not stored here.
#
# Prepare persistence on the production node first:
#   ./prepare-directories.sh

BASE_DIR=/app
DEBUG=False
ALLOWED_HOSTS=receipts.epsian.ch,receipt-processor,127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=https://receipts.epsian.ch
